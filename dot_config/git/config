[user]
	name = Kazunori Jo
	email = 519604+itochan@users.noreply.github.com
	; full fingerprint of the same key; a public GPG fingerprint is not a secret
	signingkey = E38C719B678450D60CF7CA712E389FCD49D946F3 # gitleaks:allow
[alias]
	tree = log --graph --date=short --pretty='format:%C(yellow)%h %Creset%cd %s %Cgreen(%an)%Creset %Cred%d%Creset'
	co = checkout
	ci = commit
	br = branch
	st = status -sb
	di = diff
	dic = diff --cached
	pl = pull
	fetch-pulls = fetch origin +refs/pull/*:refs/remotes/pull/*
[core]
	editor = vim
	quotepath = false
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	updateRefs = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[status]
	branch = true
	short = true
[diff]
	algorithm = histogram
	mnemonicPrefix = true
	colorMoved = zebra
	colorMovedWS = allow-indentation-change
[log]
	follow = true
[tag]
	sort = version:refname
[diff "encrypted"]
	textconv = hexdump -v -C
[gpg]
	program = gpg
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pager]
	log = diff-highlight | less
	show = diff-highlight | less
	diff = diff-highlight | less
[interactive]
	diffFilter = diff-highlight
[init]
	defaultBranch = main
[ghq]
	root = ~/go/src
	root = ~/src
[url "https://github.com/"]
	; authenticate over HTTPS via the gh credential helper (config.d/gh)
	; instead of SSH, so ssh-agent is not needed for github.com
	insteadOf = git@github.com:
[include]
	path = ~/.config/git/config.d/user
	path = ~/.config/git/config.d/gh
[commit]
	gpgsign = true
